# 此镜像汇集 Linux 下的 Go、Node、系统检查工具与项目源码快照。
# 私有环境文件和业务运行目录由 .dockerignore 排除，不参与最后的源码复制。
FROM golang:1.27.3-alpine@sha256:f2c872bcee949b7be9c490efd02b48a8a2fbf947cdf533f1c58525ec9d8170fd AS go-toolchain
FROM node:26-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS tools
COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}" GOOS=linux CGO_ENABLED=0
RUN apk add --no-cache bash git make lsof procps file
WORKDIR /workspace
COPY ./backend/go.mod ./backend/go.sum ./backend/
# 先复制依赖声明，使源码注释变化时仍能复用已下载的 Go 模块层。
RUN cd /workspace/backend && go mod download
COPY ./frontend/package*.json ./frontend/
# npm ci 按锁文件安装，禁用依赖安装脚本；缓存目录只保存可复用的下载文件。
RUN --mount=type=cache,id=leafdoc-linux-npm,target=/root/.npm cd /workspace/frontend && npm ci --ignore-scripts --prefer-offline
COPY . .
