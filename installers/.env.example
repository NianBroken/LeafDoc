# 复制为 .env 后设置随机长密码。该文件仅供 Compose 运行时读取，不进入镜像。
LEAFDOC_BIND_ADDRESS=127.0.0.1
LEAFDOC_PORT=24692
LEAFDOC_VERSION=local
LEAFDOC_MYSQL_IMAGE=mysql:8.0
LEAFDOC_MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
LEAFDOC_MYSQL_DATABASE=leafdoc
LEAFDOC_MYSQL_USER=leafdoc
LEAFDOC_MYSQL_PASSWORD=replace-with-a-long-random-database-password
LEAFDOC_BASE_PATH=
