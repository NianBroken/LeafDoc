# Node dependencies — installed fresh inside the container
frontend/node_modules/
frontend/dist/

# Local test tooling
hacks/
test-results/

# Pre-built artefacts that the Dockerfile rebuilds from scratch
dist/
releases/
leafdoc
backend/internal/http/dist/*
!backend/internal/http/dist/.gitkeep

# Runtime / local data
other/data/
backend/cmd/leafdoc/data/

# Debug binaries dropped by dlv / GoLand
**/__debug_bin*

# Docs and static assets (not needed by Go compiler or Vite)
assets/
public/

# Git and CI
.git/
.github/
.claude/
local/

# Misc
other/.env
other/.env.*
*.db

# Windows binaries never enter Linux build contexts.
*.exe
*.exe~
