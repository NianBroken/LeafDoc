# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Main binary
/backend/leafdoc

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/
node_modules/
frontend/node_modules/

# Go workspace file
go.work
go.work.sum

# env file
other/.env

other/releases/*


other/dist/*
!other/dist/.gitkeep

# data dir
other/data/

# test database files
*.db

__debug*

**/test-results/*


local

ui.zip

# Local editor configuration and generated files
.vscode/
.idea/
.fleet/
.history/
.DS_Store
Thumbs.db
desktop.ini
*.local
*.log
*.tmp
*.temp
*.bak
.cache/
coverage/

# Generated embedded frontend output
backend/internal/http/dist/*
!backend/internal/http/dist/.gitkeep

# Project instructions are versioned; personal agent overlays stay local.
/AGENTS.local.md
/CLAUDE.local.md
.claude/
.github/

# Local environment overrides
other/.env.*

# Generated build, tool cache and temporary output
backend/build/
other/build/
dist-ssr/
.vite/
.turbo/
.parcel-cache/
.npm/
.pnpm-store/
.eslintcache
*.tsbuildinfo
tmp/
temp/
__pycache__/
*.pyc

# Database journals and editor recovery files
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db3
*.mdb
*.ldb
*.rdb
*.aof
*.sql.tmp
*.sql.bak
*.swp
*.swo
*~

# Playwright reports and generated load-test credentials and results
playwright-report/
blob-report/
/loadtest/results/
/loadtest/seed/.session-pool.json
/loadtest/seed/.admin-session.json
/loadtest/seed/.writer-accounts.json
# 本地环境配置不入库，保留可共享的配置示例。
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 运行日志、Go 工具缓存和本地编辑器状态。
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.gocache/
.gomodcache/
*.suo
*.user
*.userosscache
*.sln.docstates
