# 此文件按路径和后缀排除本机构建、运行与工具产物，以下链接指向允许列表形式的参考模板。
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# 程序和插件的二进制产物不跟踪，源码和构建声明继续保留。
*.exe
*.exe~
*.dll
*.so
*.dylib

# go test -c 输出的测试程序不跟踪。
*.test

# 后端目录内编译出的应用程序不跟踪。
/backend/leafdoc

# 排除 .out 输出文件，包括匹配该后缀的覆盖率报告。
*.out

# 排除 Node 依赖目录；下一行 vendor 只是注释示例，不构成实际忽略规则。
# vendor/
node_modules/
frontend/node_modules/

# Go 本地工作区配置与校验文件不作为项目模块声明提交。
go.work
go.work.sum

# 私有环境配置不跟踪，避免提交连接资料。
other/.env

other/releases/*


other/dist/*
!other/dist/.gitkeep

# 实例正文、附件及运行状态均存放在此数据目录，不跟踪其内容。
other/data/

# 排除匹配后缀的本地数据库文件，测试仍可在临时目录创建它们。
*.db

__debug*

**/test-results/*


local

ui.zip

# 排除本地编辑器配置、系统目录元数据以及常见日志、临时文件和报告。
.vscode/
.idea/
.fleet/
.history/
.DS_Store
Thumbs.db
desktop.ini
*.local
*.log
*.tmp
*.temp
*.bak
.cache/
coverage/

# 后端嵌入页面由前端构建生成，目录占位文件除外，不跟踪生成内容。
backend/internal/http/dist/*
!backend/internal/http/dist/.gitkeep

# 项目规则文件参与版本管理，个人规则覆盖文件和所列工具目录保持本地。
/AGENTS.local.md
/CLAUDE.local.md
.claude/
.github/

# 排除私有环境文件的派生名称，后面的显式例外允许共享示例文件。
other/.env.*

# 排除构建目录、包管理缓存、类型检查缓存和临时脚本产物。
backend/build/
other/build/
dist-ssr/
.vite/
.turbo/
.parcel-cache/
.npm/
.pnpm-store/
.eslintcache
*.tsbuildinfo
tmp/
temp/
__pycache__/
*.pyc

# 排除数据库日志、其他本地数据库格式、编辑器交换文件和恢复备份。
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db3
*.mdb
*.ldb
*.rdb
*.aof
*.sql.tmp
*.sql.bak
*.swp
*.swo
*~

# 浏览器测试报告与压力测试生成的会话、账号和结果不参与版本管理。
playwright-report/
blob-report/
/loadtest/results/
/loadtest/seed/.session-pool.json
/loadtest/seed/.admin-session.json
/loadtest/seed/.writer-accounts.json
# 本地环境配置不入库，保留可共享的配置示例。
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 运行日志、Go 工具缓存和本地编辑器状态。
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.gocache/
.gomodcache/
*.suo
*.user
*.userosscache
*.sln.docstates

# 离线发行产物与本机验证资料不参与提交或镜像上下文。
installers/
.validation/
